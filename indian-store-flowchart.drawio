<mxfile host="app.diagrams.net" modified="2026-09-01T06:00:00.000Z" agent="Antigravity" version="21.0.0" type="device">
  <diagram id="indian-store-flow-diagram" name="Indian Store End-to-End Flow">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1200" background="#F8FAFC" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title Banner -->
        <mxCell id="title-box" value="&lt;b style='font-size: 22px;'&gt;INDIAN STORE AUSTRALIA 🇦🇺 - APPLICATION ARCHITECTURE &amp;amp; FLOW DIAGRAM&lt;/b&gt;&lt;br&gt;&lt;span style='font-size: 13px; color: #475569;'&gt;Comprehensive End-to-End Workflow: Keycloak Auth, RBAC Portals, Order Lifecycle, Reactive Angular Signals &amp;amp; REST/SSE Backend&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#0F172A;fontColor=#FFFFFF;align=center;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1840" height="70" as="geometry" />
        </mxCell>

        <!-- ============================================================== -->
        <!-- SWIMLANE 1: AUTHENTICATION & ROLE-BASED ACCESS CONTROL (RBAC) -->
        <!-- ============================================================== -->
        <mxCell id="lane-auth" value="🔐 AUTHENTICATION &amp; ROLE GATEWAY (Keycloak OIDC &amp; Role-Auth Guard)" style="swimlane;startSize=30;rounded=1;arcSize=8;fillColor=#EFF6FF;strokeColor=#3B82F6;fontStyle=1;fontColor=#1E3A8A;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="1840" height="180" as="geometry" />
        </mxCell>

        <mxCell id="user-entry" value="&lt;b&gt;User / Staff Access&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#64748B;'&gt;Browser URL / Route Nav&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E40AF;fontStyle=1;" vertex="1" parent="lane-auth">
          <mxGeometry x="30" y="55" width="150" height="70" as="geometry" />
        </mxCell>

        <mxCell id="role-guard" value="&lt;b&gt;Role Auth Guard&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;'&gt;Check Role in Token / URL&lt;br&gt;(roleAuthGuard.ts)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF08A;strokeColor=#CA8A04;fontColor=#854D0E;fontStyle=1;" vertex="1" parent="lane-auth">
          <mxGeometry x="230" y="45" width="180" height="90" as="geometry" />
        </mxCell>

        <mxCell id="keycloak-sso" value="&lt;b&gt;Keycloak SSO Provider&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;'&gt;PKCE Auth Flow (OpenID Connect)&lt;br&gt;Clients: &lt;i&gt;staff-client / customer-client&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#991B1B;" vertex="1" parent="lane-auth">
          <mxGeometry x="470" y="55" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="session-storage" value="&lt;b&gt;Session &amp; Token Store&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;'&gt;JWT Access Token &amp; Roles&lt;br&gt;localStorage / sessionStorage&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#5B21B6;" vertex="1" parent="lane-auth">
          <mxGeometry x="740" y="55" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="role-router" value="&lt;b&gt;Role-Based View Dispatcher&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;'&gt;StoreStateService.activeRole() Signal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#166534;fontStyle=1;" vertex="1" parent="lane-auth">
          <mxGeometry x="970" y="55" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="portal-customer" value="&lt;b&gt;🛒 Customer View&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;'&gt;Route: /store&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontStyle=1;" vertex="1" parent="lane-auth">
          <mxGeometry x="1240" y="55" width="130" height="70" as="geometry" />
        </mxCell>

        <mxCell id="portal-manager" value="&lt;b&gt;📊 Manager View&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;'&gt;Route: /manager&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontStyle=1;" vertex="1" parent="lane-auth">
          <mxGeometry x="1390" y="55" width="130" height="70" as="geometry" />
        </mxCell>

        <mxCell id="portal-ops" value="&lt;b&gt;📦 Operations View&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;'&gt;Route: /operations&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;fontColor=#9A3412;fontStyle=1;" vertex="1" parent="lane-auth">
          <mxGeometry x="1540" y="55" width="130" height="70" as="geometry" />
        </mxCell>

        <mxCell id="portal-delivery" value="&lt;b&gt;🚚 Delivery View&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;'&gt;Route: /delivery&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;fontColor=#6B21A8;fontStyle=1;" vertex="1" parent="lane-auth">
          <mxGeometry x="1690" y="55" width="130" height="70" as="geometry" />
