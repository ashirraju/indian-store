        <mxCell id="edge-a2" value="Unauthenticated /&lt;br&gt;Protected Role" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#DC2626;strokeWidth=2;fontColor=#DC2626;fontSize=10;" edge="1" parent="lane-auth" source="role-guard" target="keycloak-sso">
