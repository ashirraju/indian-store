        <!-- Unified State Service Foundation -->
        <mxCell id="unified-state" value="&lt;b style='font-size:14px;'&gt;🧠 Angular Reactive Store Engine (StoreStateService)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;'&gt;Signals: &lt;i&gt;activeRole, activePath, isCartOpen, isWishlistOpen, isOrdersModalOpen, notifications, wishlist, apiCategories&lt;/i&gt;&lt;br&gt;Computed Values: &lt;i&gt;cartTotal, gstAmount, freeShippingProgress, unreadNotificationsCount&lt;/i&gt;&lt;br&gt;Sync: LocalStorage Cache ↔ REST API (ApiService) ↔ Server-Sent Events (SSE Realtime Stream)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#0F172A;fontColor=#F8FAFC;align=center;" vertex="1" parent="lane-admin">
          <mxGeometry x="30" y="160" width="1710" height="140" as="geometry" />
