        <mxCell id="cust-browse" value="&lt;b&gt;1. Browse Catalog &amp; Hero Banners&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;'&gt;Search, GI-Tagged Filters, Regional Spices, Deals&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;fontColor=#1E293B;" vertex="1" parent="lane-customer">
