          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============================================================== -->
        <!-- SWIMLANE 2: CUSTOMER JOURNEY (STOREFRONT TO CHECKOUT)          -->
        <!-- ============================================================== -->
        <mxCell id="lane-customer" value="🛒 CUSTOMER EXPERIENCE &amp; SHOPPING FLOW (/store)" style="swimlane;startSize=30;rounded=1;arcSize=8;fillColor=#F0FDF4;strokeColor=#22C55E;fontStyle=1;fontColor=#15803D;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="880" height="480" as="geometry" />
