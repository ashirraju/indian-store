        <!-- SWIMLANE 3: FULFILLMENT LIFECYCLE (OPERATIONS & DELIVERY)       -->
        <!-- ============================================================== -->
        <mxCell id="lane-fulfillment" value="🏭 ORDER FULFILLMENT PIPELINE (Operations, Packing &amp; Last-Mile Delivery)" style="swimlane;startSize=30;rounded=1;arcSize=8;fillColor=#FFF7ED;strokeColor=#F97316;fontStyle=1;fontColor=#C2410C;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="940" y="320" width="940" height="480" as="geometry" />
