        <mxCell id="mgr-inventory" value="&lt;b&gt;Inventory &amp; Stock Matrix&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;'&gt;Real-time stock counters, low-stock alerts, auto reorder triggers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;fontColor=#1E293B;" vertex="1" parent="lane-admin">
