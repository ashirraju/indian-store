        <mxCell id="mgr-catalog" value="&lt;b&gt;Catalog &amp; Pricing Editor&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;'&gt;Add / Edit Products, GI Regions, Weight variations, AUD pricing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;fontColor=#1E293B;" vertex="1" parent="lane-admin">
