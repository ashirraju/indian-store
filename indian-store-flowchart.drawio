        <mxCell id="cust-product-modal" value="&lt;b&gt;Product Quick View &amp; Origin&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;'&gt;Nutrition, Origin Badge (Kashmir, Gujarat, etc.)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;fontColor=#1E293B;" vertex="1" parent="lane-customer">
          <mxGeometry x="30" y="225" width="240" height="55" as="geometry" />
        </mxCell>

        <mxCell id="cust-cart-action" value="&lt;b&gt;2. Cart &amp; Wishlist Management&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;'&gt;Add to Cart Drawer / Save to Wishlist Drawer&lt;br&gt;Quantity, Unit Weights &amp; GST calculation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF08A;strokeColor=#CA8A04;fontColor=#854D0E;fontStyle=1;" vertex="1" parent="lane-customer">
          <mxGeometry x="330" y="50" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="cust-checkout-form" value="&lt;b&gt;3. Australian Checkout Modal&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;'&gt;• AU Address &amp; State Selection (NSW, VIC, QLD, WA...)&lt;br&gt;• Free Shipping over $75 AUD threshold&lt;br&gt;• Payment Gateway (Card, Apple Pay, PayPal, Afterpay, COD)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;align=left;spacingLeft=10;" vertex="1" parent="lane-customer">
          <mxGeometry x="330" y="150" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="cust-place-order" value="&lt;b&gt;4. Place Order Submission&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;'&gt;POST /api/orders&lt;br&gt;Status: &lt;b style='color:#2563EB;'&gt;Placed&lt;/b&gt; 🏷️&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#166534;fontStyle=1;" vertex="1" parent="lane-customer">
          <mxGeometry x="330" y="270" width="260" height="60" as="geometry" />
        </mxCell>

        <mxCell id="cust-order-tracking" value="&lt;b&gt;5. Customer Live Order Tracking&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;'&gt;Orders Modal with Step Tracker &amp; Real-time SSE Notifications&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontStyle=1;" vertex="1" parent="lane-customer">
          <mxGeometry x="640" y="270" width="220" height="60" as="geometry" />
