        <mxCell id="cust-toasts" value="&lt;b&gt;Instant UI Feedback (Toasts)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;'&gt;Success / Info / Warning Alerts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#475569;" vertex="1" parent="lane-customer">
          <mxGeometry x="640" y="150" width="220" height="50" as="geometry" />
        </mxCell>

        <!-- Customer Connections -->
