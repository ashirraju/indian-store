        <!-- Operations Group -->
        <mxCell id="ops-queue" value="&lt;b&gt;1. Warehouse Packing Queue&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;'&gt;Incoming Orders filtered by State (NSW/VIC)&lt;br&gt;Current Status: &lt;b style='color:#2563EB;'&gt;Placed&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;fontColor=#1E293B;" vertex="1" parent="lane-fulfillment">
          <mxGeometry x="30" y="50" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ops-packing" value="&lt;b&gt;2. Item Picking &amp; Packaging&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;'&gt;Check off inventory, verify batch &amp; seal box&lt;br&gt;Action: &lt;i&gt;&quot;Start Packing&quot;&lt;/i&gt; ➔ &lt;b style='color:#D97706;'&gt;In Packing&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;" vertex="1" parent="lane-fulfillment">
          <mxGeometry x="30" y="155" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ops-ready" value="&lt;b&gt;3. Dispatch Staging &amp; Manifest&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;'&gt;Generate Courier Label (AusPost / StarTrack)&lt;br&gt;Status: &lt;b style='color:#16A34A;'&gt;Packed&lt;/b&gt; ➔ &lt;b style='color:#7C3AED;'&gt;Ready for Dispatch&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#5B21B6;" vertex="1" parent="lane-fulfillment">
          <mxGeometry x="30" y="260" width="240" height="70" as="geometry" />
        </mxCell>

        <!-- Delivery Group -->
        <mxCell id="del-assign" value="&lt;b&gt;4. Driver Pickup &amp; Route Assignment&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;'&gt;Delivery Driver accepts run from Hub (Sydney/Melb)&lt;br&gt;Status: &lt;b style='color:#9333EA;'&gt;Out for Delivery&lt;/b&gt; 🚚&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;fontColor=#6B21A8;" vertex="1" parent="lane-fulfillment">
          <mxGeometry x="330" y="260" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="del-proof" value="&lt;b&gt;5. Last-Mile Handover &amp; Proof of Delivery&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;'&gt;Capture OTP / Signature / Safe Drop photo&lt;br&gt;Status: &lt;b style='color:#16A34A;'&gt;Delivered&lt;/b&gt; ✅&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#166534;fontStyle=1;" vertex="1" parent="lane-fulfillment">
          <mxGeometry x="640" y="260" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="del-driver-console" value="&lt;b&gt;Delivery Partner Console (/delivery)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;'&gt;Active route map, customer contact chip, delivery notes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9333EA;fontColor=#1E293B;" vertex="1" parent="lane-fulfillment">
          <mxGeometry x="480" y="155" width="280" height="60" as="geometry" />
        </mxCell>

        <mxCell id="stock-decrement" value="&lt;b&gt;Automatic Stock Decrement&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;'&gt;Catalog inventory deducted &amp; low stock flagged&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#991B1B;" vertex="1" parent="lane-fulfillment">
          <mxGeometry x="330" y="50" width="260" height="60" as="geometry" />
        </mxCell>

        <!-- Fulfillment Edges -->
